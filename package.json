{
  "name": "full-stack-learning-lab",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test qa/server.test.mjs qa/admin.test.mjs qa/reminders.test.mjs && node qa/verify-accounts.mjs && node qa/verify-learning-runner.mjs && node qa/verify-runner.mjs",
    "admin": "node admin/index.mjs"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "yaml": "2.8.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1",
    "@babel/standalone": "7.28.5",
    "codemirror": "6.0.2",
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/theme-one-dark": "6.1.3",
    "esbuild": "0.25.12"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
