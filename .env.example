# Public canonical origin. Google allows localhost for development.
# Apple requires an HTTPS domain registered in Apple Developer.
APP_URL=http://localhost:13000
APP_PORT=13000
APP_BIND=127.0.0.1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional alternative to GOOGLE_CLIENT_SECRET. Put only the secret value in the file.
GOOGLE_CLIENT_SECRET_FILE=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PKCS#8 key, quoted with literal \n escapes, OR a mounted file path below.
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_FILE=

OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_IMAGE_VERSION=0.40.8
